<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pybuttoning</name>
  <version>0.1.0</version>
  <description>Python ROS2 package for dual-arm buttoning system with vision and manipulation</description>
  <maintainer email="haves@tekat.my.id">Ha ves</maintainer>
  <license>AGPL-3.0-or-later</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>buttoning_msgs</depend>
  
  <!-- Note: realsense2_camera dependencies removed - using custom pyrealsense2 node -->
  <!-- Python package pyrealsense2 should be installed via pip -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
